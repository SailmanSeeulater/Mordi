# Database
POSTGRES_DB=mordi
POSTGRES_USER=mordi
POSTGRES_PASSWORD=changeme

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mordi
SPRING_DATASOURCE_USERNAME=mordi
SPRING_DATASOURCE_PASSWORD=changeme
SPRING_REDIS_HOST=redis
JWT_SECRET=generate-a-256-bit-secret

# Frontend
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_API_BASE_URL=https://latesailor.dev

# Email through Resend (optional). Without the key the backend logs each
# message, reset link included, instead of sending it. APP_URL is the origin
# emailed links point at: locally the dev server (:5173) or Compose (:3000).
RESEND_API_KEY=
MAIL_FROM=Mordi <hello@latesailor.dev>
APP_URL=http://localhost:3000
