# Database
POSTGRES_DB=mordi
POSTGRES_USER=mordi_user
DB_PASSWORD=changeme

# Backend / JWT
JWT_SECRET=generate-a-long-random-base64-string

# Frontend
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Email through Resend (optional). Without the key the backend logs each
# message, reset link included, instead of sending it. MAIL_FROM must be on a
# domain verified in Resend. APP_URL is the origin emailed links point at:
# locally the dev server (http://localhost:5173) or Compose (:3000).
RESEND_API_KEY=
MAIL_FROM=Mordi <hello@latesailor.dev>
APP_URL=http://localhost:3000

# Web Push reminders (optional). Generate a pair with the node one-liner in
# backend/src/main/resources/application.properties. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
