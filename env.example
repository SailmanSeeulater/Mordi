# Database
POSTGRES_DB=mordi
POSTGRES_USER=mordi_user
DB_PASSWORD=changeme

# Backend / JWT
JWT_SECRET=generate-a-long-random-base64-string

# Frontend
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Umami Cloud website id (optional). Page visits are counted without cookies
# only when this is set; leave it empty locally. It is public, so in CI it is
# the repository variable (not secret) VITE_UMAMI_WEBSITE_ID.
VITE_UMAMI_WEBSITE_ID=

# Swagger UI and /v3/api-docs. Off by default; true for local poking around.
SPRINGDOC_ENABLED=false

# Email through Resend (optional). Without the key the backend drops each
# message with a warning; set LOGGING_LEVEL_COM_MORDI_BACKEND_MAIL=DEBUG to
# see the full text, reset link included, in the backend log instead.
# MAIL_FROM must be on a domain verified in Resend. APP_URL is the origin
# emailed links point at: locally the dev server (http://localhost:5173) or
# Compose (:3000).
RESEND_API_KEY=
MAIL_FROM=Mordi <hello@latesailor.dev>
APP_URL=http://localhost:3000

# Web Push reminders (optional). Generate a pair with the node one-liner in
# backend/src/main/resources/application.properties. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Usage numbers (optional). Comma-separated sign-in addresses allowed to open
# /admin/usage, which shows how many people use Mordi as counts only. Empty
# means nobody can; everyone else is told the page does not exist.
MORDI_ADMIN_EMAILS=
