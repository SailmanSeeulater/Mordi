# Database
POSTGRES_DB=mordi
POSTGRES_USER=mordi_user
DB_PASSWORD=changeme

# Backend / JWT
JWT_SECRET=generate-a-long-random-base64-string

# Frontend
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Web Push reminders (optional). Generate a pair with the node one-liner in
# backend/src/main/resources/application.properties. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
